# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# MaxMind GeoLite2 license key (from https://www.maxmind.com/en/geolite2/signup)
GEOLITE2_LICENSE_KEY=your_license_key_here

# Optional: override default data paths
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
